{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public and private user profile data",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "onboarded": { "type": "boolean" },
        "measurements": {
          "type": "object",
          "properties": {
            "weight": { "type": "number" },
            "height": { "type": "number" },
            "age": { "type": "number" },
            "gender": { "type": "string" },
            "activityLevel": { "type": "string" }
          }
        },
        "goals": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "targetWeight": { "type": "number" },
            "focus": { "type": "string" },
            "dailySteps": { "type": "number" },
            "dailyCalories": { "type": "number" },
            "macros": {
              "type": "object",
              "properties": {
                "protein": { "type": "number" },
                "carbs": { "type": "number" },
                "fat": { "type": "number" }
              }
            }
          }
        },
        "workoutPlan": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "email", "createdAt", "updatedAt"]
    },
    "Workout": {
      "title": "Workout Session",
      "description": "A single workout session logged by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "subtype": { "type": "string" },
        "duration": { "type": "number" },
        "caloriesBurned": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "exercises": {
          "type": "array",
          "items": { "type": "object" }
        },
        "notes": { "type": "string" },
        "shared": { "type": "boolean" },
        "isPlanned": { "type": "boolean" },
        "planId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "type", "date", "createdAt"]
    },
    "Nutrition": {
      "title": "Nutrition Log",
      "description": "A meal or snack logged by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "meal": { "type": "string" },
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fat": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "meal", "calories", "date", "createdAt"]
    },
    "WorkoutTemplate": {
      "title": "Workout Template",
      "description": "A reusable workout template",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "exercises": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "type", "createdAt"]
    },
    "MealTemplate": {
      "title": "Meal Template",
      "description": "A reusable meal template",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "ingredients": { "type": "array", "items": { "type": "object" } },
        "totalCalories": { "type": "number" },
        "totalProtein": { "type": "number" },
        "totalCarbs": { "type": "number" },
        "totalFat": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "category", "createdAt"]
    },
    "Post": {
      "title": "Community Post",
      "description": "A post in the community feed",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "type": { "type": "string", "enum": ["manual", "workout"] },
        "workoutId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "type", "createdAt"]
    },
    "Comment": {
      "title": "Post Comment",
      "description": "A comment on a post",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "userId", "content", "createdAt"]
    },
    "Follow": {
      "title": "User Connection",
      "description": "Follow relationship between users",
      "type": "object",
      "properties": {
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followingId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/workouts/{workoutId}": {
      "schema": "Workout",
      "description": "Workout logs"
    },
    "/nutrition/{nutritionId}": {
      "schema": "Nutrition",
      "description": "Nutrition logs"
    },
    "/workoutTemplates/{templateId}": {
      "schema": "WorkoutTemplate",
      "description": "Reusable workout templates"
    },
    "/mealTemplates/{templateId}": {
      "schema": "MealTemplate",
      "description": "Reusable meal templates"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Community posts"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments on posts"
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "User follow relationships"
    }
  }
}
