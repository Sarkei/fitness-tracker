# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/vrtx

# Auth
JWT_SECRET=change-me-in-production

# Public app URL (password reset links, CORS)
APP_PUBLIC_URL=http://localhost:3000
APP_NAME=VRTX

# Password reset email (optional — without SMTP, set ALLOW_DEV_RESET_LINK=1 for dev links in API response)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
ALLOW_DEV_RESET_LINK=0

# ExerciseDB (RapidAPI / AscendAPI) — Pflicht für Übungssuche, GIFs/Videos im Workout-Bereich
# Ohne Key: /api/exercises/search liefert 503 (exercisedb-not-configured)
# Alternativ im Admin-Panel unter /admin eintragen (schreibt EXERCISEDB_RAPIDAPI_KEY in .env)
EXERCISEDB_RAPIDAPI_KEY=
# Optional — Standard: AscendAPI V2 (Videos + Bilder)
# EXERCISEDB_RAPIDAPI_HOST=edb-with-videos-and-images-by-ascendapi.p.rapidapi.com

# AI Configuration
# Lokales Modell (Ollama — z. B. Gemma 4 E2B): Wird in docker-compose automatisch bereitgestellt und geladen.
# Kein externer API-Key für Nutzer erforderlich!
OLLAMA_BASE_URL=http://ollama:11434
LOCAL_LLM_MODEL=gemma4:e2b
# OLLAMA_PORT=11434
# OLLAMA_NUM_CTX=8192 # Kontext-Länge (Default 8192, schont NAS-RAM/CPU)

# Aktiver Provider: ollama (Standard) | mistral | gemini (im Admin unter /admin umschaltbar)
AI_ACTIVE_PROVIDER=ollama

# Optionale Cloud-Provider (nur nötig, falls als Fallback oder primär gewünscht)
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Coach Woche-1: max. KI-Neuversuche bei Schema/Constraint-Fehlern (Standard 3, max. 5)
# COACH_WORKOUT_MAX_RETRIES=3
# Modell-Overrides pro Bereich (optional):
# AI_OLLAMA_MODEL_COACH_WORKOUT=gemma4:e2b
# AI_MISTRAL_MODEL_COACH_WORKOUT=mistral-medium-latest

# Admin-Panel (/admin) — Basic-Auth, unabhängig vom App-Login
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# E2E
E2E_USER_EMAIL=e2e-coach@vrtx.test
E2E_USER_PASSWORD=E2eCoachPass123!
COACH_E2E_MOCK=1
