rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.onboarded is bool &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidWorkout(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.createdAt == request.time;
    }

    function isValidNutrition(data) {
      return data.userId == request.auth.uid &&
             data.meal is string && data.meal.size() <= 100 &&
             data.calories is number && data.calories >= 0 &&
             data.createdAt == request.time;
    }

    function isValidWorkoutTemplate(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.type is string &&
             data.createdAt == request.time;
    }

    function isValidMealTemplate(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.category is string &&
             data.createdAt == request.time;
    }

    function isValidPost(data) {
      return data.userId == request.auth.uid &&
             data.content is string && data.content.size() <= 2000 &&
             data.type in ['manual', 'workout'] &&
             data.createdAt == request.time;
    }

    function isValidComment(data) {
      return data.userId == request.auth.uid &&
             data.content is string && data.content.size() <= 500 &&
             data.createdAt == request.time;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isVerified() && isOwner(userId) && isValidUser(incoming());
      allow update: if isVerified() && isOwner(userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'goals', 'onboarded', 'measurements', 'workoutPlan', 'themePreference', 'membership', 'coachPreferences', 'updatedAt']) &&
                      incoming().updatedAt == request.time;
    }

    match /workouts/{workoutId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || existing().shared == true);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.shared == true);
      allow create: if isVerified() && isValidWorkout(incoming()) && isValidId(workoutId);
      allow update: if isVerified() && isOwner(existing().userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'duration', 'caloriesBurned', 'exercises', 'notes', 'shared']) &&
                      incoming().userId == existing().userId;
      allow delete: if isVerified() && isOwner(existing().userId);
    }

    match /nutrition/{nutritionId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(nutritionId) && isValidNutrition(incoming());
      allow update: if isVerified() && isOwner(existing().userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['meal', 'calories', 'protein', 'carbs', 'fat']) &&
                      incoming().userId == existing().userId;
      allow delete: if isVerified() && isOwner(existing().userId);
    }

    match /workoutTemplates/{templateId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(templateId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isVerified() && resource.data.userId == request.auth.uid && isValidId(templateId);
      allow create: if isVerified() && isValidWorkoutTemplate(incoming());
      allow update: if isVerified() && resource.data.userId == request.auth.uid && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'exercises', 'type', 'updatedAt']) &&
                      incoming().updatedAt == request.time;
    }

    match /mealTemplates/{templateId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(templateId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isVerified() && resource.data.userId == request.auth.uid && isValidId(templateId);
      allow create: if isVerified() && isValidMealTemplate(incoming());
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isVerified() && isValidPost(incoming()) && isValidId(postId);
      allow update: if isVerified() && (
        (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'imageUrl'])) ||
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['likes']))
      );
      allow delete: if isVerified() && isOwner(existing().userId);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isVerified() && isValidComment(incoming()) && isValidId(commentId);
        allow delete: if isVerified() && (isOwner(existing().userId) || isOwner(get(/databases/$(database)/documents/posts/$(postId)).data.userId));
      }
    }

    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && incoming().followerId == request.auth.uid && isValidId(followId);
      allow delete: if isVerified() && (existing().followerId == request.auth.uid || existing().followingId == request.auth.uid);
    }
  }
}
