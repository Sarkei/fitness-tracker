{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "docker:dev": "docker compose -f docker-compose.dev.yaml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yaml up --build",
    "start": "node server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --packages=external --platform=node --format=esm --outfile=server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:decompose": "tsx scripts/decompose-invariant-selftest.ts",
    "test:coach": "tsx scripts/coach-pipeline-selftest.ts",
    "test:coach-engine": "tsx scripts/coach-engine-selftest.ts",
    "test:coach-match": "tsx scripts/coach-match-selftest.ts",
    "test:coach-nutrition-pp": "tsx scripts/coach-nutrition-postprocess-selftest.ts",
    "test:coach-dashboard": "tsx scripts/coach-dashboard-selftest.ts",
    "test:coach-flow": "tsx scripts/coach-flow-selftest.ts",
    "test:coach-ops": "tsx scripts/coach-ops-evaluate-selftest.ts",
    "test:coach:all": "npm run test:coach-engine && npm run test:coach-match && npm run test:coach-nutrition-pp && npm run test:coach-dashboard && npm run test:coach-flow && npm run test:coach-ops",
    "test:meal-portion": "tsx scripts/meal-portion-selftest.ts",
    "test:exercise-resolve": "tsx scripts/exercise-resolve-selftest.ts",
    "test:coach-warmup": "tsx scripts/coach-warmup-selftest.ts",
    "test:nutrition-log": "tsx scripts/nutrition-log-selftest.ts",
    "test:nutrition-log-golden": "tsx scripts/nutrition-log-golden.ts",
    "test:nutrition-log:all": "npm run test:nutrition-log && npm run test:nutrition-log-golden",
    "test:nutrition-v3": "tsx scripts/nutrition-v3-selftest.ts",
    "test:nutrition-v3-off": "tsx scripts/nutrition-v3-off-integration-selftest.ts",
    "test:nutrition-v3-coach-manual": "tsx scripts/nutrition-v3-coach-manual-selftest.ts",
    "test:nutrition-v3-incidents": "tsx scripts/nutrition-v3-incidents-selftest.ts",
    "test:nutrition-v3-negative": "tsx scripts/nutrition-v3-negative-selftest.ts",
    "test:nutrition-v3-performance": "tsx scripts/nutrition-v3-performance-budget-selftest.ts",
    "test:nutrition-v3-load": "tsx scripts/nutrition-v3-load-soak-selftest.ts",
    "test:nutrition-v3-reprocess": "tsx scripts/nutrition-v3-reprocess-selftest.ts",
    "test:nutrition-v3-ux": "tsx scripts/nutrition-v3-ux-selftest.ts",
    "test:db:up": "node scripts/test-db-up.mjs",
    "test:nutrition-v3:all": "npm run test:nutrition-v3 && npm run test:nutrition-v3-off && npm run test:nutrition-v3-coach-manual && npm run test:nutrition-v3-stored && npm run test:nutrition-v3-metrics && npm run test:nutrition-v3-performance && npm run test:nutrition-v3-load && npm run test:nutrition-v3-negative && npm run test:nutrition-v3-reprocess && npm run test:nutrition-v3-contract && npm run test:nutrition-v3-contract:int && npm run test:nutrition-v3-incidents && npm run test:nutrition-v3-ux",
    "ci:nutrition": "npm run test:nutrition-v3:all && npm run test:nutrition-log:all && npm run build",
    "ci:nutrition:strict": "node scripts/ci-nutrition-strict.mjs",
    "ci:nutrition:db": "npm run test:db:up && npm run ci:nutrition:strict",
    "test:nutrition-v3-stored": "tsx scripts/nutrition-v3-stored-meal-selftest.ts",
    "test:nutrition-v3-metrics": "tsx scripts/nutrition-v3-metrics-selftest.ts",
    "test:nutrition-v3-contract": "tsx scripts/nutrition-v3-contract-selftest.ts",
    "test:nutrition-v3-contract:int": "tsx scripts/nutrition-v3-contract-integration-selftest.ts",
    "test:e2e:nutrition": "playwright test -c playwright.e2e.config.ts e2e/nutrition-v3-flow.spec.ts",
    "test:workout-session": "tsx scripts/workout-session-selftest.ts",
    "seed:e2e": "tsx scripts/seed-coach-e2e.ts",
    "ops:coach": "tsx scripts/coach-ops-check.ts",
    "ops:coach:alert": "tsx scripts/coach-ops-alert.ts",
    "ops:coach:health": "tsx scripts/coach-ops-alert.ts -- --http",
    "test:e2e": "playwright test",
    "test:e2e:coach": "playwright test e2e/coach-refine-report.spec.ts",
    "test:e2e:coach:live": "playwright test -c playwright.staging.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "ci:coach": "npm run test:coach:all && npm run test:e2e:coach"
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.8",
    "pg": "^8.20.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.6",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.5.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "react-leaflet": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
